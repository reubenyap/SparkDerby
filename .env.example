# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sparkderby
DATABASE_USER=spark
DATABASE_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=CHANGE_ME_redis_password

# Firo RPC (leave FIRO_RPC_HOST empty or 'mock' for development)
FIRO_RPC_HOST=
FIRO_RPC_PORT=8888
FIRO_RPC_USER=firouser
FIRO_RPC_PASSWORD=CHANGE_ME_rpc_password
FIRO_RPC_TIMEOUT=30000

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Admin API key (required for /admin/* endpoints in production)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Treasury / Reserve addresses
TREASURY_SPARK_ADDRESS=
RESERVE_SPARK_ADDRESS=

# Session secret (required in production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_session_secret
SESSION_TTL_DAYS=30

# Telegram (optional — log-only mode if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
